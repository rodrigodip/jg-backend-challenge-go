# Local development defaults. Copy to .env and adjust. No real secrets here.
APP_MODE=api
HTTP_ADDR=:8080
ADMIN_ADDR=:9090

# App role (no DDL, no ledger UPDATE/DELETE). Owner credentials live only
# in the migrate job / operator shell, never in app containers.
DATABASE_URL=postgres://app:appsecret@postgres:5432/wallet?sslmode=disable
MIGRATE_DATABASE_URL=postgres://owner:ownersecret@postgres:5432/wallet?sslmode=disable

# SQS emulator (MiniStack). Non-numeric keys share the default account.
SQS_ENDPOINT=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=appuser
AWS_SECRET_ACCESS_KEY=appsecret
SQS_CONSUMER_KEY=consumeruser
SQS_CONSUMER_SECRET=consumersecret
SQS_PUBLISHER_KEY=publisheruser
SQS_PUBLISHER_SECRET=publishersecret

# Keycloak (local realm import).
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=wallet
OIDC_ISSUER=http://keycloak:8080/realms/wallet
